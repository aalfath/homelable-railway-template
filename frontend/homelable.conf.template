# Rendered by the nginx entrypoint (envsubst) at container start.
# Only ${PORT}, ${BACKEND_UPSTREAM} and ${NGINX_LOCAL_RESOLVERS} are substituted.
server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20M;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $homelable_backend ${BACKEND_UPSTREAM};

    # WebSocket (must come before /api/ to take priority)
    location /api/v1/status/ws/ {
        proxy_pass http://$homelable_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 3600s;
    }

    location /api/ {
        proxy_pass http://$homelable_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # Interactive API docs (Swagger UI, ReDoc, OpenAPI schema)
    location /docs {
        proxy_pass http://$homelable_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location /redoc {
        proxy_pass http://$homelable_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location = /openapi.json {
        proxy_pass http://$homelable_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # Legacy /ws/ path
    location /ws/ {
        proxy_pass http://$homelable_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
